# FocusDesk — .gitignore
# Prevents secrets, build artifacts, and dependency caches from being committed

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment files — NEVER commit .env with real secrets ──────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Build outputs ─────────────────────────────────────────────────────────────
frontend/dist/
frontend/build/
backend/build/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor configs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker (local) ────────────────────────────────────────────────────────────
# NOTE: docker-compose.yml IS committed. Only local overrides are ignored.
docker-compose.override.yml
