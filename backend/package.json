{
  "name": "focusdesk-backend",
  "version": "1.0.0",
  "description": "FocusDesk productivity workspace API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testEnvironment=node --forceExit --passWithNoTests",
    "test:watch": "jest --watch --testEnvironment=node",
    "test:coverage": "jest --coverage --testEnvironment=node --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 20000
  },
  "keywords": [
    "taskflow",
    "nodejs",
    "express",
    "in-memory"
  ],
  "author": "Aryan Tada",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
